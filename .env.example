# Plaud access token, cookies, device/workspace tuple, and rotating refresh
# token are stored as one verified item in macOS Keychain — never in this file.
# Use the app's Auth button > Plaud Web Login for the recommended one-time setup.

# Set to 0 only when automatic access-token renewal must be disabled.
PLAUD_AUTO_REFRESH=1

# Other non-auth Plaud Note Manager preferences may remain in .env.
